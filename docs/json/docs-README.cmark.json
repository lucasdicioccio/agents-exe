[3,[19]],"tag":"TextualMark"},{"contents":[3,[19]],"tag":"TextualMark"},{"contents":[5,[19]],"tag":"TextualMark"},{"contents":[4,[19]],"tag":"TextualMark"},{"contents":[3,[19]],"tag":"TextualMark"},{"contents":[4,[19]],"tag":"TextualMark"},{"contents":[3,[19]],"tag":"TextualMark"},{"contents":[4,[19]],"tag":"TextualMark"},{"contents":[4,[19]],"tag":"TextualMark"}]},"snippetInfos":[{"snippetContents":"# Build the project\ncabal build\n\n# Run the durable-workflow demonstrator (no API key needed)\ncabal run durable-workflow-demo\n\n# Run tests\ncabal test\n","snippetType":"bash"},{"snippetContents":"{\n  \"slug\": \"my-agent\",\n  \"apiKeyId\": \"openai\",\n  \"flavor\": \"openai\",\n  \"modelUrl\": \"https://api.openai.com/v1\",\n  \"modelName\": \"gpt-4\",\n  \"announce\": \"A helpful assistant\",\n  \"systemPrompt\": [\"You are a helpful assistant.\"],\n  \"toolDirectory\": \"tools\",\n  \"mcpServers\": [],\n  \"extraAgents\": []\n}\n","snippetType":"json"},{"snippetContents":"# Check agent configuration\nagents-exe check --agent-file agent.json\n\n# Run in one-shot mode\nagents-exe run --agent-file agent.json --prompt \"Hello!\"\n\n# Start interactive TUI\nagents-exe tui --agent-file agent.json\n\n# Start MCP server\nagents-exe mcp-server --agent-file agent.json\n","snippetType":"bash"},{"snippetContents":"{\n  \"openai\": \"sk-...\",\n  \"openrouter\": \"sk-...\"\n}\n","snippetType":"json"},{"snippetContents":"{\n  \"agentsDirectories\": [\"./agents\"],\n  \"agentsFiles\": [\"./main-agent.json\"],\n  \"agentsLogs\": {\n    \"logJsonHttpEndpoint\": \"http://localhost:8080/log\",\n    \"logJsonPath\": \"./logs/agents.json\",\n    \"logRawPath\": \"./logs/agents.log\"\n  }\n}\n","snippetType":"json"},{"snippetContents":"agents/\n├── app/                      # Application entry point\n│   └── Main.hs              # CLI argument parsing and command routing\n├── examples/                # Runnable example programs\n│   └── durable-workflow-demo/\n│       └── Main.hs          # Self-contained durable workflow demonstrator\n├── src/\n│   └── System/Agents/\n│       ├── Base.hs          # Core types (Agent, AgentId, ConversationId)\n│       ├── Runtime.hs       # Agent runtime and execution\n│       ├── AgentTree.hs     # Multi-agent hierarchy management\n│       ├── Session/         # Session management\n│       ├── Tools/           # Tool system\n│       ├── MCP/             # Model Context Protocol\n│       ├── TUI/             # Terminal UI\n│       ├── CLI/             # Command implementations\n│       ├── ExportImport/    # Tool sharing\n│       └── FileLoader/      # File loading utilities\n├── documentation/                    # Documentation\n└── test/                    # Test suite\n","snippetType":""},{"snippetContents":"# Resume a session\nagents-exe run --agent-file agent.json --session-file session.json\n\n# Print session history\nagents-exe session-print session.json\n","snippetType":"bash"},{"snippetContents":"# Pause after one async step\nagents session pause <session-id> --agent-file agent.json\n\n# List deferred calls\nagents session pending <session-id>\n\n# Inject an external result\nagents session complete <token> result.json\n\n# Resume until completion or next yield\nagents session resume <session-id> --agent-file agent.json\n","snippetType":"bash"},{"snippetContents":"┌─────────────────────────────────────────────────────────────┐\n│                        CLI / TUI / MCP                       │\n└──────────────────────┬──────────────────────────────────────┘\n                       │\n┌──────────────────────▼──────────────────────────────────────┐\n│                      AgentTree                               │\n│         (multi-agent hierarchy management)                   │\n└──────────────────────┬──────────────────────────────────────┘\n                       │\n┌──────────────────────▼──────────────────────────────────────┐\n│                     Runtime                                  │\n│    (agent execution, tool registration, LLM calls)           │\n└──────────────────────┬──────────────────────────────────────┘\n                       │\n        ┌──────────────┼──────────────┐\n        ▼              ▼              ▼\n┌──────────────┐ ┌──────────┐ ┌──────────────┐\n│   Session    │ │  Tools   │ │     LLM      │\n│  Management  │ │  System  │ │  Integration │\n└──────────────┘ └──────────┘ └──────────────┘\n","snippetType":""}]}