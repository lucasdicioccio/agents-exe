-- The terminal UI, kept out of agents-lib so that programs embedding the
-- agents (such as agents-server) do not depend on brick and vty.
library agents-tui
    import:           warnings
    visibility:       public
    hs-source-dirs:   tui
    default-language: Haskell2010
    default-extensions: OverloadedStrings, OverloadedRecordDot
    exposed-modules:  System.Agents.CLI
                    , System.Agents.CLI.Config
                    , System.Agents.CLI.TUI
                    , System.Agents.TUI.Buffer
                    , System.Agents.TUI.Clipboard
                    , System.Agents.TUI.Core
                    , System.Agents.TUI.Event
                    , System.Agents.TUI.Event.Attachment
                    , System.Agents.TUI.Event.Conversation
                    , System.Agents.TUI.Event.Dialog
                    , System.Agents.TUI.Event.Draft
                    , System.Agents.TUI.Event.Navigation
                    , System.Agents.TUI.KeyMapping
                    , System.Agents.TUI.MessageComposer
                    , System.Agents.TUI.Render
