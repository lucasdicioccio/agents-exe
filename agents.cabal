                    , System.Agents.TUI.Render.Conversation
                    , System.Agents.TUI.Render.Dialog
                    , System.Agents.TUI.Render.Layout
                    , System.Agents.TUI.Render.Utils
                    , System.Agents.TUI.Render.Widgets
                    , System.Agents.TUI.Types
                    , System.Agents.TUI.Types.Conversation
                    , System.Agents.TUI.Types.Core
                    , System.Agents.TUI.Types.State
    build-depends:    base >=4.18.3.0,
                      agents-lib,
                      aeson,
                      aeson-pretty,
                      async,
                      base64-bytestring,
                      brick,
                      bytestring,
                      containers,
                      data-default,
                      directory,
                      filepath,
                      lens,
                      process,
                      process-extras,
                      prodapi,
                      sqlite-simple,
                      stm,
                      temporary,
                      text,
                      text-zipper,
                      time,
                      uuid,
                      vector,
                      vty

-- Sessions and continuations in Postgres; a separate library so that
-- agents-lib does not depend on libpq.
library agents-postgres
    import:           warnings
    visibility:       public
    hs-source-dirs:   postgres
    default-language: Haskell2010
    default-extensions: OverloadedStrings, OverloadedRecordDot
    exposed-modules:  System.Agents.Postgres
    build-depends:    base >=4.18.3.0,
                      agents-lib,
                      aeson,
                      bytestring,
                      postgresql-simple,
                      resource-pool,
                      text,
                      time,
                      uuid

test-suite agents-postgres-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   postgres/test
    main-is:          Main.hs
    ghc-options:      -threaded
    default-language: Haskell2010
    default-extensions: OverloadedStrings, OverloadedRecordDot
    build-depends:    base >=4.18.3.0,
                      agents-lib,
                      agents-postgres,
