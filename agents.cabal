                      aeson,
                      text,
                      uuid
    hs-source-dirs:   examples/durable-workflow-demo
    default-language: Haskell2010
    default-extensions: OverloadedStrings, OverloadedRecordDot

-- The HTTP server lives in a private library so that its test suite can
-- run the application; wai and warp stay out of agents-lib.
library agents-server-internal
    import:           warnings
    hs-source-dirs:   examples/agents-server/src
    exposed-modules:  AgentsServer.Api
                    , AgentsServer.Auth
                    , AgentsServer.Log
                    , AgentsServer.Mcp
                    , AgentsServer.OpenApi
                    , AgentsServer.Routes
                    , AgentsServer.Server
                    , AgentsServer.Types
                    , AgentsServer.UI
    build-depends:    base >=4.18.3.0,
                      agents-lib,
                      agents-postgres,
                      aeson,
                      async,
                      bytestring,
                      case-insensitive,
                      containers,
                      crypton,
                      directory,
                      http-api-data,
                      http-client,
                      http-types,
                      insert-ordered-containers,
                      lens,
                      network,
                      openapi3,
                      optparse-applicative,
                      prodapi,
                      servant,
                      servant-openapi3,
                      servant-server,
                      stm,
                      text,
                      time,
                      unix,
                      uuid,
                      vector,
                      wai,
                      warp
    default-language: Haskell2010
    default-extensions: OverloadedStrings, OverloadedRecordDot

executable agents-server
    import:           warnings
    main-is:          Main.hs
    ghc-options:      -threaded
    build-depends:    base >=4.18.3.0,
                      agents-server-internal,
                      aeson,
                      optparse-applicative
    hs-source-dirs:   examples/agents-server/app
