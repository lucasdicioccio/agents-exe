          {"$ref": "#/parameters/rowFilter.tasks.title"},
          {"$ref": "#/parameters/rowFilter.tasks.done"},
          {"$ref": "#/parameters/rowFilter.tasks.limit"},
          {"$ref": "#/parameters/rowFilter.tasks.offset"},
          {"$ref": "#/parameters/rowFilter.tasks.order"}
