    },
    "rowFilter.tasks.limit": {
      "name": "limit",
      "in": "query",
      "description": "Limit the number of rows returned",
      "type": "integer"
    },
    "rowFilter.tasks.offset": {
      "name": "offset",
      "in": "query",
      "description": "Skip a number of rows",
